# inbox2pod configuration. Copy to .env and edit.
# Only FEED_TITLE + one ingest source are required; everything else has a default.

# ─── Ingest: IMAP poller (the easy path) ────────────────────────────────────
# Gmail: turn on 2FA, create an app password, use it as IMAP_PASSWORD.
# Use a dedicated mailbox (or a Gmail filter that labels+marks a copy) instead
# of pointing this at an inbox you also read by hand.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=newsletters@example.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX
IMAP_POLL_MINUTES=5
IMAP_MAX_EMAILS_PER_POLL=25

# What to do with a message after it becomes an episode:
#   mark_seen (default) | none | delete | move:<folder>
# "delete" is the closest thing to a self-cleaning mailbox; try mark_seen first.
IMAP_AFTER_ACTION=mark_seen

# ─── Ingest: SMTP receiver (the power path, opt-in) ─────────────────────────
# Newsletter senders deliver to whatever address you give them; no app
# passwords, no reading your personal mail. Give the senders a random local
# part you never publish anywhere else — that address is the authentication.
SMTP_ENABLED=false
SMTP_LISTEN_HOST=0.0.0.0
SMTP_LISTEN_PORT=2525
SMTP_ALLOWED_RCPT=x7kq2m@pod.example.com
SMTP_MAX_SIZE=10485760

# ─── Applies to both sources ────────────────────────────────────────────────
# Comma-separated addresses or domains. Empty accepts everything.
# SENDER_ALLOWLIST=news@dailyledger.example, tldr.com
SENDER_ALLOWLIST=

# ─── Text to speech (FlaskTtS) ──────────────────────────────────────────────
TTS_ROOT_URL=http://localhost:5001
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_BATCH_SIZE=10

# Wake-on-LAN for a TTS box that sleeps. The container has to be able to send
# UDP broadcasts to your LAN: run it on host networking, or route the broadcast.
TTS_WOL_ENABLED=false
TTS_WOL_MAC=
TTS_WOL_BROADCAST=255.255.255.255
TTS_WOL_PORT=9
TTS_WOL_RETRY_DELAY=30
TTS_WOL_MAX_RETRIES=6

# ─── Storage ────────────────────────────────────────────────────────────────
# Relative paths resolve against the project root; the Docker image uses /app/data
DATABASE_URI=sqlite:///data/inbox2pod.db
RAW_STORAGE_PATH=data/raw
MP3_STORAGE_PATH=data/audio

# Delete episodes (and their audio) older than this many days. Empty = keep forever.
# EPISODE_RETENTION_DAYS=60
EPISODE_RETENTION_DAYS=

# ─── Feed ───────────────────────────────────────────────────────────────────
FEED_TITLE=Inbox Letters
FEED_DESCRIPTION=My newsletters, read aloud
FEED_AUTHOR=Your Name
# Required by Apple Podcasts if you ever submit this feed
FEED_OWNER_EMAIL=you@example.com
FEED_LANGUAGE=en-us
# Where the feed says the podcast "lives"; the feed URL itself is derived from
# the request, so this is usually your homepage
FEED_SITE_URL=https://pod.example.com/

# Secret that gates the feed, the UI and the audio files. Podcast apps cannot
# do real auth, so the token rides in the URL. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(8))"
# Leave empty to serve everything unauthenticated (LAN only, basically).
FEED_TOKEN=

FEED_MAX_EPISODES=1000

# ─── Extraction ─────────────────────────────────────────────────────────────
# Episodes whose extracted text is shorter than this are flagged in the UI for
# review instead of being synthesized (a 40-second reading of "unsubscribe" is
# not a podcast). Raise it if you get thin episodes, lower it for short digests.
MIN_TEXT_LENGTH=200
DESCRIPTION_LENGTH=300

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5003
# FLASK_ENV=dev gives you the Flask reloader and debug pages. Never in prod.
FLASK_ENV=

# Durable SMTP work queue; keep this on persistent storage alongside the DB.
SMTP_SPOOL_PATH=data/smtp-spool

# Connection and read inactivity limits for TTS HTTP requests, in seconds.
TTS_CONNECT_TIMEOUT=5
TTS_READ_TIMEOUT=120

# External origin for feed/audio/cover URLs behind a reverse proxy or Tailscale Serve.
# Example: https://podbox.your-tailnet.ts.net (no trailing path)
FEED_BASE_URL=
